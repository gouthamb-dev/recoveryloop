        <mxCell id="loop-annotation" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#D4E5F3;strokeColor=#394954;fontSize=10;spacingLeft=5;spacingTop=2;" value="&lt;b&gt;Agentic Retry Loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;1. Build prompt (session context)&lt;br&gt;2. Invoke Bedrock → script&lt;br&gt;3. Strip code fences&lt;br&gt;4. Execute in MicroVM sandbox&lt;br&gt;5. If fails → feed error back (max 2 retries)&lt;br&gt;6. Save session → stream final result&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="900" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sse-annotation" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#FFE082;strokeColor=#564500;fontSize=10;spacingLeft=5;spacingTop=2;" value="&lt;b&gt;SSE Event Stream&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;session_start → bedrock_start →&lt;br&gt;script_generated → sandbox_start →&lt;br&gt;stdout/stderr → retry → final&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="230" y="560" as="geometry" />
        </mxCell>
        <mxCell id="security-annotation" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#FFDAD6;strokeColor=#93000A;fontSize=10;spacingLeft=5;spacingTop=2;" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• TLS everywhere (ACM cert)&lt;br&gt;• Least-privilege IAM&lt;br&gt;• Input validation on all params&lt;br&gt;• Firecracker VM isolation&lt;br&gt;• Security headers (HSTS, CSP)&lt;br&gt;• S3 public access blocked&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="1190" y="260" as="geometry" />
        </mxCell>
        <mxCell id="tech-stack" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#F5EDDF;strokeColor=#D0C6AF;fontSize=10;spacingLeft=5;spacingTop=2;" value="&lt;b&gt;Tech Stack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Frontend: Svelte 4 + Vite 5 + TypeScript&lt;br&gt;Backend: Node.js 22 + TypeScript 5&lt;br&gt;IaC: AWS SAM (CloudFormation)&lt;br&gt;LLM: Amazon Nova 2 Lite (Converse API)&lt;br&gt;Sandbox: Lambda MicroVMs (Firecracker)&lt;br&gt;State: DynamoDB (on-demand, 24h TTL)&lt;br&gt;CDN: CloudFront + S3 + ACM&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="240" x="1100" y="130" as="geometry" />
        </mxCell>
      </root>
